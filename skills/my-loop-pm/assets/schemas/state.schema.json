{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "my-loop v3 · state.json",
  "type": "object",
  "required": ["phase", "task", "classification", "current_ticket"],
  "additionalProperties": false,
  "properties": {
    "phase": { "enum": ["idle", "align", "build", "review", "awaiting_acceptance", "done"] },
    "task": { "type": ["string", "null"], "description": "当前变更一句话" },
    "classification": { "enum": ["simple", "medium", "big", "bug", null] },
    "current_ticket": { "type": ["string", "null"], "description": "WIP=1：同一时刻至多一条" },
    "harness": {
      "type": ["object", "null"],
      "description": "用户指定的工具、环境及模型选择，适用时沿用；未指定模型沿用宿主当前设置",
      "additionalProperties": false,
      "properties": {
        "runtime": { "type": "string", "description": "用户指定的执行环境或工具，例如当前宿主或 Herdr" },
        "build_kind": { "type": "string" },
        "review_kind": { "type": "string" }
      }
    },
    "updated": { "type": ["string", "null"], "description": "YYYY-MM-DD" },
    "review_policy": {
      "type": ["object", "null"],
      "description": "用户指定的本任务验收方式和标准；未选择时为 null",
      "required": ["mode", "acceptance"],
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["notify", "self"] },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "review_evidence": {
      "type": ["string", "null"],
      "description": "最终验收回执路径；记录所验产物、逐项证据，notify 模式含用户通过反馈"
    }
  },
  "allOf": [
    {
      "if": { "required": ["phase"], "properties": { "phase": { "enum": ["review", "awaiting_acceptance", "done"] } } },
      "then": { "required": ["review_policy"], "properties": { "review_policy": { "type": "object" } } }
    },
    {
      "if": { "required": ["phase"], "properties": { "phase": { "const": "done" } } },
      "then": { "required": ["review_evidence"], "properties": { "review_evidence": { "type": "string", "minLength": 1 } } }
    }
  ]
}
